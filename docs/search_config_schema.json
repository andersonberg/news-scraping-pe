{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/news-scraping-pe/search-config.schema.json",
  "title": "SearchConfig",
  "description": "Configuração de buscas para o pipeline de scraping.",
  "type": "object",
  "required": ["version", "search_terms", "portals", "candidates", "discovery"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "project": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "search_terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "keywords"],
        "properties": {
          "id": { "type": "string" },
          "keywords": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "extra_keywords": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Palavras fixas além do nome do candidato (ex.: justiça eleitoral)."
          },
          "description": { "type": "string" }
        }
      }
    },
    "portals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "domain", "tier"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "domain": { "type": "string" },
          "tier": {
            "type": "integer",
            "enum": [1, 2, 3],
            "description": "Prioridade do portal (1 = regional, 2 = nacional, 3 = fallback)."
          },
          "enabled": { "type": "boolean", "default": true },
          "search_url_template": { "type": "string" },
          "spider": { "type": "string" }
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "office", "election_year", "query_window"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "office": {
            "type": "string",
            "enum": ["presidente", "governador_pe"]
          },
          "election_year": { "type": "integer", "enum": [2018, 2022] },
          "query_window": {
            "type": "object",
            "required": ["start", "end"],
            "properties": {
              "start": { "type": "string", "format": "date" },
              "end": { "type": "string", "format": "date" }
            }
          },
          "search_name_variants": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Variações do nome para query (ex.: sobrenome só)."
          },
          "enabled": { "type": "boolean", "default": true }
        }
      }
    },
    "discovery": {
      "type": "object",
      "properties": {
        "serpapi": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "engine": { "type": "string", "enum": ["google", "google_news"] },
            "prefer_site_restricted": { "type": "boolean" },
            "max_results_per_query": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        },
        "gdelt": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "use_only_if_coverage_below": { "type": "integer" }
          }
        },
        "national_fallback": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "min_articles_per_candidate": { "type": "integer" }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "articles_path": { "type": "string" },
        "urls_pending_path": { "type": "string" },
        "format": { "type": "string", "enum": ["jsonl"] }
      }
    }
  }
}

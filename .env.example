# Copie para .env e preencha (nunca commitar .env)

# SerpAPI — descoberta de URLs (Tier 2)
SERPAPI_API_KEY=

# Opcional: GDELT via BigQuery (Tier 2 complementar)
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/service-account.json
# GDELT_PROJECT_ID=

# Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Timeout (segundos) para download de artigos na extração de texto
EXTRACTION_TIMEOUT_SECONDS=30

# Medium — publicação via API (scripts/publish_to_medium.py)
# Gere em: https://medium.com/me/settings/security → Integration tokens
MEDIUM_INTEGRATION_TOKEN=

# Scrapy
SCRAPY_SETTINGS_MODULE=news_scraping_pe.scrapy.settings

# Caminhos (relativos à raiz do repositório)
SEARCH_CONFIG_PATH=config/searches.yaml
ARTICLES_OUTPUT_PATH=data/articles.jsonl
URLS_PENDING_PATH=data/urls_pending.jsonl
